# Public site URL. Used for canonical URLs, sitemap, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://wedgeacquisition.com

# Neon Postgres connection string. Added automatically by the Vercel Marketplace integration.
DATABASE_URL=

# CRM inbound webhook. Every qualified lead is POSTed here as flat JSON.
CRM_WEBHOOK_URL=

# Booking calendar embed URL, shown on /book. Optional vendor script for auto-height.
NEXT_PUBLIC_BOOKING_EMBED_URL=
NEXT_PUBLIC_BOOKING_EMBED_SCRIPT=

# Random secret. Vercel sends it as a Bearer token to the retry cron. openssl rand -hex 32
CRON_SECRET=

# Random secret mixed into IP hashes so raw IPs are never stored. openssl rand -hex 32
IP_HASH_SALT=

# HTTP Basic Auth login for /admin/leads. /admin is locked if these are empty.
ADMIN_USER=
ADMIN_PASSWORD=

# Optional alerts. Failures are posted here so you can call the lead by hand.
ALERT_SLACK_WEBHOOK_URL=
RESEND_API_KEY=
ALERT_EMAIL_TO=
# Optional sender for alert emails. Must be on a domain verified in Resend.
# Defaults to Resend's test sender, which only delivers to your own Resend account email.
ALERT_EMAIL_FROM=

# Optional tracking. Nothing loads unless these are set.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
